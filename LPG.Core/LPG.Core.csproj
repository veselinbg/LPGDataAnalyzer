<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Analysis code and screens shared by LPGDataAnalyzer (log files) and LPGDbAnalyzer (database).
    Namespaces stay LPGDataAnalyzer.*: the code was moved here from LPGDataAnalyzer unchanged.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LPGDataAnalyzer</RootNamespace>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="WinForms.DataVisualization" Version="1.10.0" />
  </ItemGroup>

</Project>
